{
  "name": "Smart Dash",
  "short_name": "Smart Dash",
  "description": "Control every smart device in your home from one place.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": ["lifestyle", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Devices", "url": "./#/devices", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scenes", "url": "./#/scenes", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Energy", "url": "./#/energy", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
